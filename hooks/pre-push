#!/bin/bash
# Fast pre-push gate: lint + tests without the coverage gate.
# The coverage-gated run (`pytest` with fail_under) is CI's job: .github/workflows/ci.yml
set -e

BRANCH_NAME=$(git symbolic-ref --short HEAD)
echo "pre-push on branch: $BRANCH_NAME"

for tool in ruff pytest; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Error: $tool is not installed. Activate the venv and run 'pip install -r requirements.txt'."
        exit 1
    fi
done

ruff check src tests scripts
ENABLE_PREFECT_DECORATOR=false pytest -q --no-cov -p no:cacheprovider
