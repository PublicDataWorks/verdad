# Copy to .env (git-ignored). python-dotenv loads it in the entrypoints and in scripts/run_stage.py.
# Never commit real values.

# --- LLM / embedding providers -------------------------------------------------
GOOGLE_GEMINI_KEY=            # Gemini API key used by stages 1, 3 and 4 (google-genai / ADK)
GOOGLE_GEMINI_PAID_KEY=       # Alternate Gemini key; only src/main.py (ad-hoc stage 4 smoke script) uses it
GOOGLE_API_KEY=               # Set automatically from GOOGLE_GEMINI_KEY by stage_4/flows.py for the ADK agents; leave empty
OPENAI_API_KEY=               # OpenAI key: text-embedding-3-large (stage 5, KB retrieval), whisper-1 helper

# --- Storage: Cloudflare R2 (S3-compatible) ---------------------------------------
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Database: Supabase -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=                 # service-role key used by the pipeline (SupabaseClient)
SUPABASE_ANON_KEY=            # anon key; only .claude/skills/verdad-heuristics-updater/scripts/deploy_prompts.py uses it

# --- Web search (stage 3 tools, stage 4 web researcher via MCP) -------------------
SEARXNG_URL=                  # e.g. https://verdad-searxng.fly.dev (see fly.searxng.toml)

# --- Observability -----------------------------------------------------------------
SENTRY_DSN=                   # optional; sentry_sdk.init(dsn=None) is a no-op

# --- Prefect / runtime --------------------------------------------------------------
PREFECT_API_URL=              # Prefect server API, e.g. http://127.0.0.1:4200/api locally; prod is set in fly.*.toml
FLY_PROCESS_GROUP=            # Selects which deployment src/processing_pipeline/main.py or src/recording.py serves (see fly.*.toml [processes])
ENABLE_PREFECT_DECORATOR=     # "false" runs @optional_flow/@optional_task as plain functions (tests, scripts/run_stage.py); default true

# --- CI only (GitHub Actions secrets / job env; never put these in .env) --------------
# FLY_API_TOKEN (deploy token for the processing-worker app) and GITHUB_TOKEN drive the prompt workflows
# (.github/workflows/prompt-evaluation.yml, prompts-deploy.yml) through scripts/ci/*; see docs/PROMPT_EVALUATION.md.

# --- src/scripts/delete_flow_runs.py (cron on the prefect app) --------------------
BATCH_SIZE=                   # concurrent deletions per batch (default 10)
DELAY_BETWEEN_BATCHES=        # seconds between batches (default 5.0)
