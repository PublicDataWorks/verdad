# Copy to .env (git-ignored). python-dotenv loads it in the entrypoints and in scripts/run_stage.py.
# Never commit real values. Keep comments on their own lines: python-dotenv reads a trailing
# "# comment" on an unquoted value as part of the value.

# --- LLM / embedding providers -------------------------------------------------
# Gemini API key used by stages 1, 3 and 4 (google-genai / ADK)
GOOGLE_GEMINI_KEY=
# Set automatically from GOOGLE_GEMINI_KEY by stage_4/flows.py for the ADK agents; leave empty
GOOGLE_API_KEY=
# OpenAI key: text-embedding-3-large (stage 5, KB retrieval)
OPENAI_API_KEY=

# --- Model selection (src/processing_pipeline/model_config.py; docs/OPERATIONS.md "Switching models") --------
# Empty = current production model (shown in parentheses). Any Gemini/Gemma model id is accepted.
# Stage 1 initial, untimed transcription (gemini-2.5-flash)
STAGE1_TRANSCRIPTION_MODEL=
# Stage 1 initial and main disinformation detection (gemini-2.5-flash)
STAGE1_DETECTION_MODEL=
# Stage 1 timestamped transcription: segments = 20 s clips to a generate_content model, transcribe = gemini-3.5-transcribe word timestamps (segments)
STAGE1_TRANSCRIPTION_METHOD=
# Stage 1 timestamped transcription model, stored as stage_1_llm_responses.transcriptor (gemini-2.5-flash; gemini-3.5-transcribe with the transcribe method)
STAGE1_TIMESTAMP_MODEL=
# Stage 1 flow shape (true/false): one Transcribe call per recording gives the untimed and [MM:SS] transcripts; needs STAGE1_TRANSCRIPTION_METHOD=transcribe (false)
STAGE1_TRANSCRIBE_FIRST=
# Stage 1 detection passes: two = initial detection, then main detection when flagged; one = main detection on every recording, needs STAGE1_TRANSCRIBE_FIRST=true (two)
STAGE1_DETECTION_PASSES=
# Stage 1 flagged snippet times from Transcribe word timestamps when the row has them (false)
STAGE1_ANCHOR_TIMESTAMPS=
# Stage 2: cut snippets that carry word times (start_s/end_s from STAGE1_ANCHOR_TIMESTAMPS) at ms precision around the words (false)
STAGE2_USE_WORD_TIMES=
# Stage 2 padding in float seconds for the word-time cut; empty = the flow's context_before/after_seconds (90 / 60)
STAGE2_CONTEXT_BEFORE_S=
STAGE2_CONTEXT_AFTER_S=
# Stage 3 analysis, stored as snippets.analyzed_by (gemini-2.5-pro)
STAGE3_MAIN_MODEL=
# Stage 3 analysis after an API error from the main model (gemini-2.5-flash)
STAGE3_FALLBACK_MODEL=
# Stage 3 JSON restructuring of an analysis that fails validation (gemini-2.5-flash)
STAGE3_RESTRUCTURE_MODEL=
# Stage 3: copy an earlier same-station airing's analysis onto a repeat instead of calling Gemini (false)
STAGE3_REPEAT_DEDUP=
# Stage 4 kb_researcher and web_researcher agents (gemini-2.5-flash)
STAGE4_RESEARCHER_MODEL=
# Stage 4 analysis_reviewer agent, stored as snippets.reviewed_by (gemini-2.5-pro)
STAGE4_REVIEWER_MODEL=
# Stage 4 analysis_reviewer thinking: minimal | low | medium | high (unset: medium on Gemini 3.x, the model's
# default on 2.5, nothing on Gemma). 3.x defaults to high, whose thoughts eat the 16k output cap.
STAGE4_REVIEWER_THINKING=
# Stage 4 kb_updater agent (disabled), stored as kb_entries.created_by_model (gemini-2.5-flash)
STAGE4_KB_WRITER_MODEL=

# --- Storage: Cloudflare R2 (S3-compatible) ---------------------------------------
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Database: Supabase -------------------------------------------------------------
SUPABASE_URL=
# service-role key used by the pipeline (SupabaseClient)
SUPABASE_KEY=
# anon key; only .claude/skills/verdad-heuristics-updater/scripts/deploy_prompts.py uses it
SUPABASE_ANON_KEY=

# --- Web search (stage 3 tools, stage 4 web researcher via MCP) -------------------
# e.g. https://verdad-searxng.fly.dev (see fly.searxng.toml)
SEARXNG_URL=
# optional; Jina search key, enables stage 3's once-per-analysis fallback tool jina_web_search (VER-415)
JINA_API_KEY=

# --- Observability -----------------------------------------------------------------
# optional; sentry_sdk.init(dsn=None) is a no-op
SENTRY_DSN=

# --- Prefect / runtime --------------------------------------------------------------
# Prefect server API, e.g. http://127.0.0.1:4200/api locally; prod is set in fly.*.toml
PREFECT_API_URL=
# Basic-auth credential "user:password" for the Prefect API (Fly secret on every app; the server holds the same value
# as PREFECT_SERVER_API_AUTH_STRING). Also what the UI login form asks for. VER-384
PREFECT_API_AUTH_STRING=
# Selects which deployment src/processing_pipeline/main.py or src/recording.py serves (see fly.*.toml [processes])
FLY_PROCESS_GROUP=
# Anything but "true" runs @optional_flow/@optional_task as plain functions (tests, scripts/run_stage.py)
ENABLE_PREFECT_DECORATOR=true

# --- CI only (GitHub Actions secrets / job env; never put these in .env) --------------
# FLY_API_TOKEN (deploy token for the processing-worker app) and GITHUB_TOKEN drive the prompt workflows
# (.github/workflows/prompt-evaluation.yml, prompts-deploy.yml) through scripts/ci/*; see docs/PROMPT_EVALUATION.md.

# --- src/scripts/delete_flow_runs.py (cron on the prefect app) --------------------
# concurrent deletions per batch (default 10)
BATCH_SIZE=
# seconds between batches (default 5.0)
DELAY_BETWEEN_BATCHES=

# --- src/scripts/check_recording_coverage.py (hourly cron on the prefect app; VER-422) ---------
# Needs SUPABASE_URL, SUPABASE_KEY (service key) and SENTRY_DSN (recording-worker Sentry project).
# Fleet alert when no audio_files row was created in this many minutes (default 60)
FLEET_WINDOW_MIN=
# Per-station alert when the newest recorded_at (chunk start) is older than this many minutes (default 90)
STATION_STALE_MIN=
# Hours of audio_files read per run (default 24)
COVERAGE_LOOKBACK_HOURS=
# How far back to look for the last chunk of a station with nothing in the lookback (default 30)
COVERAGE_HISTORY_DAYS=

# --- src/scripts/ensure_recording_runs.py (recording watchdog, cron :07/:22/:37/:52 on the prefect app; VER-421) ---
# Uses PREFECT_API_URL / PREFECT_API_AUTH_STRING, and SENTRY_DSN for error events and the Crons check-in.
# A Scheduled/Late run older than this many minutes fails the tick: no worker is taking it (default 30)
WATCHDOG_SCHEDULED_STALE_MINUTES=
# Cancel a run that has been Pending this many minutes (default 10)
WATCHDOG_PENDING_STALE_MINUTES=
# A Running run with no task start in this many minutes is a zombie and is cancelled (default 45)
WATCHDOG_RUNNING_IDLE_MINUTES=
# Force a Cancelling run this many minutes old to Cancelled (default 10)
WATCHDOG_CANCELLING_STALE_MINUTES=
# Stations checked in parallel (default 8)
WATCHDOG_CONCURRENCY=
# Start a worker machine from FLY_MACHINE_IDS once it has been stopped this many minutes (default 5; VER-429)
WATCHDOG_MACHINE_STOPPED_MINUTES=
# Fly apps whose machines the watchdog lists (default recording-worker,generic-recording-worker,processing-worker)
WATCHDOG_WORKER_APPS=
# Lock shared by restart_all.sh and the watchdog; exported by scripts/start_cron.sh (default /tmp/verdad-recording.lock)
RECORDING_LOCK_FILE=

# --- scripts/restart_all.sh + src/scripts/cancel_all_flows.py (6-hourly restart; VER-424) ---------
# Seconds restart_all.sh waits for the recording lock before proceeding without it (default 300)
RESTART_LOCK_WAIT_SECONDS=
# Seconds cancel_all_flows.py waits for cancelled runs to finish before forcing the rest (default 90)
CANCEL_WAIT_SECONDS=
# Seconds between its polls while waiting (default 5)
CANCEL_POLL_INTERVAL_SECONDS=
